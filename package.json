{
  "name": "rapidity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/ensure-browsers.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:property": "vitest run property.test",
    "test:sr": "node scripts/test-sr.mjs",
    "lint:schema": "node scripts/lint-schema.mjs",
    "lint:a11y": "node scripts/build-a11y-pages.mjs && node scripts/lint-a11y.mjs",
    "lint:deps": "depcruise packages apps --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.10.5",
    "ajv": "^8.17.1",
    "dependency-cruiser": "^16.9.0",
    "fast-check": "^3.23.2",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
